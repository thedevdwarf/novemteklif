# Listener portları
PORT_INTERNAL=7878
PORT_PUBLIC=7879
BIND_ADDR=127.0.0.1

# /mcp endpoint'i için zorunlu Bearer token (Authorization: Bearer <token>
# veya X-API-Key: <token>). Boş bırakılırsa /mcp fail-closed olur — HİÇBİR
# istek yetkilendirilmez (401). Üretimde uzun, rastgele bir değerle doldur,
# örn: openssl rand -hex 32
MCP_AUTH_TOKEN=

# /mcp için IP başına dakikadaki istek limiti. Aşılırsa 429 döner.
MCP_RATE_LIMIT_PER_MINUTE=60

# MongoDB
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB=teklify

# PDF çıktı dizini. Boş/kaldırılmış bırakılırsa proje-içi server/out
# kullanılır (her zaman yazılabilir). İstersen WSL içinde başka bir
# yola override edebilirsin, örn: OUT_DIR=/home/<kullanici>/Teklifler
OUT_DIR=

# Public preview için kullanılacak base URL
# (cloudflared tunnel hangi domaine bağlıysa)
PUBLIC_BASE_URL=https://teklif.novem.com.tr

# Preview token TTL (gün)
PREVIEW_TTL_DAYS=7

# Şirket sabit bilgileri (kapakta ve footer'da)
COMPANY_NAME=Novem Yazılım ve Danışmanlık Tic. Ltd. Şti.
COMPANY_ADDRESS=Atatürk Mh. Komsan Üstü Yolu Cd. Residence Quality No:4/28 Küçükçekmece / İstanbul
COMPANY_TAX=Halkalı V.D. · 632 155 9162

# Teklif numara öneki
PROPOSAL_PREFIX=NVM

# Telegram bot (send_message_to_member tool için).
# openclaw config'inde zaten kayıtlı bot token'ı buraya da koy
# (aynı bot — outgoing sendMessage için ayrıca polling yapmıyor).
TELEGRAM_BOT_TOKEN=
